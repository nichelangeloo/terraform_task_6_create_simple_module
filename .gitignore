# Local .terraform directories (contains provider binaries and modules)
.terraform/

# .tfstate files (contains sensitive plain-text backend data)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (contains sensitive inputs/secrets)
*.tfvars
*.tfvars.json

# Ignore override files (used for quick, non-committed local tweaks)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created during terraform apply
.terraform.tfstate.lock.info

# Include tfplan files to ignore manual execution plan outputs
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc
